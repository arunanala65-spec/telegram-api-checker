# Copy these into your host's Environment / Secrets settings. Never commit a real token.
BOT_TOKEN=123456:your_token_from_botfather
# Your Telegram user ID(s), comma-separated. Strongly recommended so only you can use the bot.
ALLOWED_USER_IDS=
MAX_FILE_LINES=100
BULK_CONCURRENCY=5
# Default region for /ses when no region is given in the command
AWS_REGION=ap-south-1
# Telegram chat ID that receives masked logs. Optional: you can also just send /loghere once in your private chat with the bot.
LOG_CHAT_ID=
# Optional custom path for the file log (default: logs/checker.log next to bot.py)
LOG_FILE=
